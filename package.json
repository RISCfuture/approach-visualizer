{
  "name": "approach-visualizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,scss,sass}\" \"public/*.css\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{vue,css,scss,sass}\" \"public/*.css\" --fix",
    "lint:knip": "knip",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:oxlint && pnpm run lint:knip",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:stylelint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@babylonjs/core": "^9.33.1",
    "@primeuix/themes": "^3.1.0",
    "@sentry/vue": "^11.10.0",
    "@vueuse/core": "^15.0.0",
    "normalize.css": "^8.0.1",
    "pinia": "^4.1.0",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.90.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-csp-guard": "^4.0.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
